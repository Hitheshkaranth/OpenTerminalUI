# ============================================================================
# OpenTerminalUI — single configuration file
# ----------------------------------------------------------------------------
# Copy this file to `.env` (the installer does this for you) and fill in keys.
#   cp .env.example .env
# Easiest way to add/update keys interactively:  make keys   (or ./scripts/setup-keys.sh)
#
# Data-provider keys are optional: the app runs with built-in fallback data
# providers when they are absent. The SECURITY / RUNTIME values below are not:
# Docker Compose refuses to start without them.
# This one file is read by both the backend and Docker Compose. You do NOT
# need a separate backend/.env anymore.
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime environment  (REQUIRED)
# ----------------------------------------------------------------------------
# "production" (the default when blank/unset — fail closed) or "development"
# ("dev", "local", "test" also count) for single-user local use. Outside
# development: secrets below are mandatory, SQLite is refused (use Postgres via
# DATABASE_URL), and auth can not be switched off.
OPENTERMINALUI_ENV=

# ----------------------------------------------------------------------------
# Security secrets  (REQUIRED; auto-generated by ./install.sh — or generate each
# one yourself with:   openssl rand -hex 32   )
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=
CACHE_SIGNING_KEY=
# Password for the bundled Redis (docker compose). Use hex so it is URL-safe.
REDIS_PASSWORD=
# Password for the bundled Postgres (docker compose). Use hex so it is URL-safe.
POSTGRES_PASSWORD=
POSTGRES_USER=openterminalui
POSTGRES_DB=openterminalui

# ----------------------------------------------------------------------------
# First-run admin account  (auto-generated by ./install.sh)
# A unique admin account is seeded on first launch so you can log in
# immediately — no "user not found" errors. Credentials are printed at the
# end of the install. Change the password after first login.
# Seeding is skipped automatically once any user exists.
# ----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@openterminal.local
BOOTSTRAP_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Market data API keys  (all optional)
# ----------------------------------------------------------------------------
# Financial Modeling Prep — US equities, fundamentals, earnings
FMP_API_KEY=
# Finnhub — US real-time WebSocket ticks
FINNHUB_API_KEY=
FINNHUB_WS_ENABLED=true
# FRED — macro / economic series
FRED_API_KEY=
# Alpaca — US market data
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_ADJUSTMENT=raw
# Zerodha Kite — India NSE/BSE real-time + historical
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# AI / LLM (optional — powers news sentiment & emotion analysis)
# ----------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# OpenRouter — powers the in-app agent console AND news emotion analysis
# (key starts with sk-or-...).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Agent / emotion LLM routing. AGENT_PROVIDER: openrouter | openai | lmstudio | gemini.
# AGENT_MODEL: an OpenRouter model id (use a :free model for the free tier) or a gemini model (e.g. gemini-2.0-flash).
# AGENT_FALLBACK_MODELS: comma-separated fallback models tried in order when the
# primary is rate-limited (429) or unavailable (404). Keep all entries ":free" if using openrouter free tier.
GEMINI_API_KEY=
AGENT_PROVIDER=openrouter
AGENT_MODEL=openai/gpt-oss-20b:free
AGENT_FALLBACK_MODELS=openai/gpt-oss-20b:free,qwen/qwen3-coder:free,meta-llama/llama-3.3-70b-instruct:free
# AGENT_DEBATE_ENABLED: enable multi-agent debate mode (analyst team -> bull/bear
# -> portfolio manager). The Agent console exposes a "Debate" toggle; set this to
# true so that toggle works. Debate runs several LLM calls per request.
AGENT_DEBATE_ENABLED=true
# LM Studio (locally hosted Gemma model). Start LM Studio, load a Gemma model,
# enable its local server, then set LM_STUDIO_ENABLED=true.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-26b-a4b
LM_STUDIO_ENABLED=true

# ----------------------------------------------------------------------------
# Infrastructure / runtime (sensible defaults — usually no need to change)
# ----------------------------------------------------------------------------
# Database. DATABASE_URL is the single setting the app reads; when blank it falls
# back to OPENTERMINALUI_SQLITE_URL, which is only allowed in development.
# Docker Compose defaults DATABASE_URL to the bundled Postgres
# (postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB).
# Single-user Docker on SQLite instead: OPENTERMINALUI_ENV=development and
# DATABASE_URL=sqlite:////data/openterminal.db
DATABASE_URL=
OPENTERMINALUI_SQLITE_URL=sqlite:///data/openterminalui.db
# Redis for running the backend outside Docker (compose builds its own URL from
# REDIS_PASSWORD). Include the password if your Redis requires one:
#   redis://:<password>@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
OPENTERMINALUI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENTERMINALUI_PREFETCH_ENABLED=0
CHART_CACHE_TTL=900
OHLCV_HOT_TTL_SECONDS=300
OHLCV_WARM_TTL_SECONDS=86400
OHLCV_COLD_ROOT=data/bars

# Optional FXMacroData authorization; public USD data works without a key.
FXMACRODATA_API_KEY=

# ----------------------------------------------------------------------------
# Process, scaling and observability
# ----------------------------------------------------------------------------
# Run `alembic upgrade head` on container start. Set 0 on all but one replica.
RUN_MIGRATIONS=1
# 0 = API-only process: no schedulers, ingestors, paper/alert engines or hub feeds.
# Run exactly one replica with 1 (the engine tier) and the rest with 0.
RUN_BACKGROUND_SERVICES=1
# uvicorn workers per container. Each worker runs its own background services, so
# keep 1 unless RUN_BACKGROUND_SERVICES=0.
WEB_CONCURRENCY=1
# Reverse-proxy trust. FORWARDED_ALLOW_IPS: proxy IPs uvicorn trusts for
# X-Forwarded-* (comma list, never "*" on an exposed port). TRUST_PROXY_HEADERS=1
# makes the rate limiter key on X-Forwarded-For (only behind a trusted proxy).
FORWARDED_ALLOW_IPS=127.0.0.1
TRUST_PROXY_HEADERS=0
# Auth endpoint rate limiting (never disable in production).
RATE_LIMIT_ENABLED=1
# Logging: JSON lines by default (LOG_FORMAT=text for human-readable output).
LOG_LEVEL=INFO
LOG_FORMAT=json
# In-process (L1) cache bound, and the SQLite fallback cache file.
CACHE_L1_MAX_ENTRIES=5000
OPENTERMINALUI_CACHE_DB=trade_screens_cache.db
